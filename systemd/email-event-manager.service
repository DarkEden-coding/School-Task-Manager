[Unit]
Description=Email Event Manager
Documentation=file:///opt/email-event-manager/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=email-event-manager
Group=email-event-manager
WorkingDirectory=/opt/email-event-manager
Environment=NODE_ENV=production
Environment=EMAIL_MANAGER_HOST=127.0.0.1
Environment=EMAIL_MANAGER_PORT=8787
Environment=EMAIL_MANAGER_BASE_URL=http://127.0.0.1:8787
Environment=EMAIL_MANAGER_STATE_DIR=/var/lib/email-event-manager
EnvironmentFile=-/etc/email-event-manager/environment
ExecStart=/usr/bin/node /opt/email-event-manager/dist/main.js
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
UMask=0077
StateDirectory=email-event-manager
StateDirectoryMode=0700
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/email-event-manager

[Install]
WantedBy=multi-user.target
