# Optional systemd environment overrides. Copy values to
# /etc/email-event-manager/environment; do not commit that file.
# The service itself sets these safe local defaults.
EMAIL_MANAGER_HOST=127.0.0.1
EMAIL_MANAGER_PORT=8787
EMAIL_MANAGER_BASE_URL=http://127.0.0.1:8787
EMAIL_MANAGER_STATE_DIR=/var/lib/email-event-manager

# Put only deployment-specific secrets here if a future app version requires
# them. Google and ChatGPT OAuth connections are completed in the app and their
# credentials belong in its protected state directory, not in this example.
